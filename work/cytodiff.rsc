11:["$","section",null,{"id":"results","children":[["$","div",null,{"className":"eyebrow","children":"03 / RESULTS & EVALUATION"}],["$","p",null,{"children":"Adding 5,000 synthetic images per class increased ResNet accuracy from 27% to 78% and CLIP accuracy from 62% to 77% in the reported limited-data experiment. I presented CytoDiff at the CVAMD workshop at ICCV 2025 in Honolulu."}],["$","figure",null,{"className":"accuracy-figure","children":[["$","figcaption",null,{"children":"Classification accuracy in the reported limited-data experiment"}],["$","div",null,{"className":"chart-legend","children":[["$","span",null,{"children":[["$","i",null,{}],"Real data only"]}],["$","span",null,{"children":[["$","i",null,{}],"With synthetic data"]}]]}],[["$","div","ResNet",{"className":"bar-group","children":[["$","div",null,{"className":"bar-label","children":["ResNet",["$","span",null,{"children":["+",51," percentage points"]}]]}],["$","div",null,{"className":"bar-track","children":["$","div",null,{"className":"bar baseline","style":{"width":"27%"},"children":[27,"%"]}]}],["$","div",null,{"className":"bar-track","children":["$","div",null,{"className":"bar augmented","style":{"width":"78%"},"children":[78,"%"]}]}]]}],["$","div","CLIP",{"className":"bar-group","children":[["$","div",null,{"className":"bar-label","children":["CLIP",["$","span",null,{"children":["+",15," percentage points"]}]]}],["$","div",null,{"className":"bar-track","children":["$","div",null,{"className":"bar baseline","style":{"width":"62%"},"children":[62,"%"]}]}],["$","div",null,{"className":"bar-track","children":["$","div",null,{"className":"bar augmented","style":{"width":"77%"},"children":[77,"%"]}]}]]}]],["$","p",null,{"children":"5,000 synthetic images per class. Source: CytoDiff, ICCV Workshops 2025."}]]}],false,["$","div",null,{"className":"research-context","children":[["$","span",null,{"children":"Evaluation scope"}],["$","p",null,{"children":"These gains are specific to the study’s dataset and experimental setup. Generalisation to other datasets and settings requires further evaluation."}]]}]]}]
12:["$","section",null,{"id":"contribution","children":[["$","div",null,{"className":"eyebrow","children":"04 / MY CONTRIBUTION"}],["$","p",null,{"children":"I developed the training, generation and classification pipeline during my internship at Helmholtz Munich, under the supervision of Rao Muhammad Umer and Carsten Marr. The project became my bachelor’s thesis and an ICCV Workshops paper, on which I am first author."}],["$","figure",null,{"className":"presentation-photo","children":[["$","img",null,{"src":"/images/jan-presenting-cytodiff-honolulu.jpg","width":"1800","height":"1350","alt":"Jan Carreras Boada explaining the CytoDiff poster to an attendee at ICCV 2025 in Honolulu.","loading":"lazy","decoding":"async"}],["$","figcaption",null,{"children":[["$","span",null,{"children":"ICCV 2025 · Honolulu"}],["$","span",null,{"children":"Presenting CytoDiff at the CVAMD workshop"}]]}]]}]]}]
13:["$","section",null,{"id":"application","children":[["$","div",null,{"className":"eyebrow","children":"05 / APPLICATION & TRANSFERABLE SKILLS"}],["$","p",null,{"children":"The study uses white blood cell images, where rare cell types create a challenging classification problem. My bioinformatics background helped connect model evaluation with the properties of the data."}],["$","figure",null,{"className":"case-image","children":[["$","img",null,{"src":"/images/cytodiff-cells.png","width":"1940","height":"902","loading":"lazy","alt":"Published CytoDiff figure comparing real white blood cells (top) and generated synthetic cells (bottom) across five cell types."}],["$","figcaption",null,{"children":"Real cells (top) and synthetic counterparts (bottom). CytoDiff, Carreras Boada, Umer & Marr, 2025."}]]}],["$","div",null,{"className":"transferable-skills","children":[["$","h3",null,{"children":"What this work demonstrates"}],["$","p",null,{"children":"Parameter-efficient fine-tuning, computer vision, data augmentation, imbalanced learning and reproducible ML pipelines."}]]}]]}]
