 language models, active learning and task-specific rules. The methods address entity detection, limited annotation budgets, terminology variation and the conversion of free text into normalised records."}],["$","ol",null,{"className":"pipeline","children":[["$","li","Unstructured text",{"children":[["$","span",null,{"className":"pipeline-number","children":["0",1]}],["$","span",null,{"children":"Unstructured text"}],["$","$Lb",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right","size":18,"aria-hidden":"true"}]]}],["$","li","Detect & extract",{"children":[["$","span",null,{"className":"pipeline-number","children":["0",2]}],["$","span",null,{"children":"Detect & extract"}],["$","$Lb",null,{"ref":"$undefined","iconNode":"$1:1:props:children:1:props:children:1:props:children:1:props:children:2:props:children:0:props:children:2:props:iconNode","className":"lucide-arrow-right","size":18,"aria-hidden":"true"}]]}],"$L10","$L11"]}]]}],"$L12","$L13","$L14","$L15"]}]]}],"$L16","$L17"]}],"$L18"]
