12:["$","section",null,{"id":"results","children":[["$","div",null,{"className":"eyebrow","children":"03 / RESULTS & EVALUATION"}],["$","p",null,{"children":"ClinicAno’s hybrid configuration achieved 0.875 recall and 0.858 F1 on 50 held-out notes. MEDDOCAN alone achieved the higher F1 of 0.881, making the precision–recall trade-off explicit. Related score-extraction workflows standardised information for downstream analysis."}],false,false,["$","div",null,{"className":"research-context","children":[["$","span",null,{"children":"Evaluation scope"}],["$","p",null,{"children":"Results belong to the collaborative studies and their evaluation settings. The hybrid approach prioritised recall; performance should be re-evaluated for new document types and domains."}]]}]]}]
13:["$","section",null,{"id":"contribution","children":[["$","div",null,{"className":"eyebrow","children":"04 / MY CONTRIBUTION"}],["$","p",null,{"children":"I am a co-author on four team contributions covering ClinicAno, genomic entity recognition, APGAR extraction and ECOG standardisation. They connect NLP methods with repeatable data-processing workflows."}],false]}]
14:["$","section",null,{"id":"application","children":[["$","div",null,{"className":"eyebrow","children":"05 / APPLICATION & TRANSFERABLE SKILLS"}],["$","p",null,{"children":"The source documents are Spanish and Catalan clinical notes. Tasks include de-identification, genomic entities, and APGAR and ECOG scores, with outputs prepared for clinical research and OMOP-based analysis."}],false,["$","div",null,{"className":"transferable-skills","children":[["$","h3",null,{"children":"What this work demonstrates"}],["$","p",null,{"children":"Multilingual NLP, information extraction, data-centric model adaptation, human-in-the-loop annotation and automation of repeated text-processing tasks."}]]}]]}]
